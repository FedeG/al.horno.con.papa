# Google Analytics (React)
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXX

# Generate source maps for debugging
GENERATE_SOURCEMAP=true

# Instagram Sync (scripts/)
# El login es OPCIONAL y se desaconseja para perfiles públicos (se corre
# anónimo, sin riesgo para ninguna cuenta). Solo configurar si el perfil es
# privado o Instagram exige sesión. El script reutiliza el session file y no
# hace login en cada corrida.
INSTAGRAM_USERNAME=al.horno.con.papa
INSTAGRAM_LOGIN_USERNAME=
INSTAGRAM_LOGIN_PASSWORD=

# Bing Indexing API (scripts/)
BING_API_KEY=xxxxxxxx

# Google Cloud (scripts/)
GOOGLE_CREDENTIALS_PATH=credentials/al-horno-con-papa-xxxxxxxxx.json

# Site
SITE_URL=https://alhornoconpapa.com.ar/
